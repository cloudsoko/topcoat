    { "fieldname": "internal_rating", "label": "Internal Rating", "fieldtype": "Data", "perm_role": "manager" },
    { "fieldname": "notes", "label": "Notes", "fieldtype": "Text" },
    { "fieldname": "payment_terms", "label": "Payment Terms (added at runtime)", "fieldtype": "Select", "options": ["Net 30", "Net 60", "Prepaid"] }
  ]
}
